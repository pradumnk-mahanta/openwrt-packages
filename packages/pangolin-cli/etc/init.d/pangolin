#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=01

start_service() {
	local env_file=/etc/pangolin/pangolin-site.env

	[ -r "$env_file" ] || {
		echo "Create $env_file with SITE_ID, SITE_SECRET and PANGOLIN_ENDPOINT." >&2
		return 1
	}

	procd_open_instance
	procd_set_param command /bin/sh -ec '
		umask 077
		set -a
		. "$1"
		: "${SITE_ID:?Set SITE_ID}" "${SITE_SECRET:?Set SITE_SECRET}" "${PANGOLIN_ENDPOINT:?Set PANGOLIN_ENDPOINT}"
		# Use the upstream managed-container setting to disable binary self-updates.
		export NEWT_SYSTEM_SUBSTRATE=CONTAINER
		exec /usr/bin/pangolin up site
	' pangolin "$env_file"
	procd_set_param file "$env_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
